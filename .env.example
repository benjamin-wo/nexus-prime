# Copy to .env for local development. Never commit real values.
ENVIRONMENT=dev
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus

# Telegram (leave TELEGRAM_BOT_TOKEN unset to disable the channel).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# ADMIN_TELEGRAM_CHAT_ID=
# TELEGRAM_ALLOWED_USER_IDS=
# DEFAULT_HOME_CURRENCY=SGD
# DEFAULT_TIMEZONE=Asia/Singapore

# LLM: openrouter | gemini | deepseek | openai
# On OpenRouter everything (chat, fallbacks, receipt photos, email) goes through it.
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENROUTER_FALLBACK_MODELS=      # comma separated, tried in order
# OPENROUTER_VISION_MODEL=         # reads receipt photos; unset = OPENROUTER_MODEL
# CHAT_REASONING=low               # low (default), on, off, or default (the model's own)
# OPS_TOKEN=                       # lets a script read /api/ops/report (Bearer); unset: owner only
# OPS_SALT=                        # keys the user hash in ops events; unset: the webhook secret
# OPS_EVENTS=true                  # false records no ops events
# OPS_GITHUB_TOKEN=                # Issues read+write on OPS_GITHUB_REPO: one issue per problem
# OPS_GITHUB_REPO=                 # owner/name
# OPS_TICKET_HOURS=72              # the window each 6-hourly run looks at
# OPS_TICKET_SEVERITY=medium       # high, medium or low: the least that gets an issue
# Gemini directly instead:
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.7-flash
# LLM_FALLBACK_MODEL=
