# Copy to .env for local development. Never commit real values.
ENVIRONMENT=dev
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus

# Telegram (leave TELEGRAM_BOT_TOKEN unset to disable the channel).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# ADMIN_TELEGRAM_CHAT_ID=
# TELEGRAM_ALLOWED_USER_IDS=
# DEFAULT_HOME_CURRENCY=SGD
# DEFAULT_TIMEZONE=Asia/Singapore

# LLM: gemini | openrouter | deepseek | openai
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.7-flash
# LLM_FALLBACK_MODEL=
