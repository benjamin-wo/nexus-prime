# Telegram Bot & Webhook Settings
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_WEBHOOK_SECRET="random_secret_token_for_telegram_webhook_verification"
ADMIN_TELEGRAM_CHAT_ID="123456789"

# Database Configuration (Railway Managed PostgreSQL)
# Leave blank to fallback to SQLite (sqlite+aiosqlite:///./test_assistant.db) for local testing
DATABASE_URL="postgresql+asyncpg://user:password@hostname:5432/dbname"

# Symmetric Encryption Vault Key (32-byte url-safe base64-encoded bytes for Fernet)
# You can generate one via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=""

# AI & Multimodal Model Keys
GOOGLE_API_KEY="your_google_gemini_api_key_here"
GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL="gemini-3.1-flash-lite"
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-v4-flash"
LLM_PROVIDER="deepseek"
OPENAI_API_KEY="your_openai_api_key_here"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""

# Capability Plugin & External Service API Keys
TAVILY_API_KEY="your_tavily_search_api_key_here"
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"
GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"
LTA_ACCOUNT_KEY="your_singapore_lta_datamall_account_key_here"
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
OUTLOOK_EMAIL=""
OUTLOOK_APP_PASSWORD=""
WEBAPP_URL="https://your-production-app.up.railway.app"

# Application Settings
ENVIRONMENT="production"
PORT=8000
